#include <zephyr/kernel.h>
#include <zephyr/logging/log.h>

#include "app.h"

/** @brief Initialize the logging module. */
LOG_MODULE_REGISTER(app, CONFIG_APP_LOG_LEVEL);

int
main(void)
{
    int ret;

    LOG_INF("{{ app_name }} starting.");
{%- if use_led %}

    /* Not fatal: a board without an led0 alias logs a warning and continues. */
    (void)app_led_init();
{%- endif %}
{%- if 'FsApi' in modules %}

    /* Before the network, so the file system is mounted before a remote
       client can reach it. Not fatal: the app runs without a file system. */
    ret = app_FsApi_init();
    if (ret < 0)
    {
        LOG_ERR("FsApi init failed: %d", ret);
    }
{%- endif %}

    ret = app_net_init();
    if (ret < 0)
    {
        LOG_ERR("Network init failed: %d", ret);
        return 0;
    }

    ret = app_rpc_init();
    if (ret < 0)
    {
        LOG_ERR("RPC init failed: %d", ret);
        return 0;
    }
{% for mod in modules if mod not in ['TraceModule', 'FsApi'] %}
    ret = app_{{ mod }}_init();
    if (ret < 0)
    {
        LOG_ERR("{{ mod }} init failed: %d", ret);
        return 0;
    }
{% endfor %}
    app_trace_init();

    LOG_INF("{{ app_name }} running.");

    while (1)
    {
        k_msleep(5000);
    }

    return 0;
}
