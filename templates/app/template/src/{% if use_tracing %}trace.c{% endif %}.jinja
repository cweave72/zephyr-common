/*******************************************************************************
 *  @file: trace.c
 *
 *  @brief: Enables the TraceRam CTF backend once the app is up.
*******************************************************************************/
#include <zephyr/kernel.h>
#include <zephyr/logging/log.h>

#include "TraceRam.h"
#include "app.h"

LOG_MODULE_DECLARE(app, CONFIG_APP_LOG_LEVEL);

int
app_trace_init(void)
{
    LOG_INF("Enabling trace ram.");
    TraceRam_enable();
    return 0;
}
