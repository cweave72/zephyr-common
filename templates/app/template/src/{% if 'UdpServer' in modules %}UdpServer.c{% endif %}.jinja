#include "app.h"

LOG_MODULE_DECLARE(app, CONFIG_APP_LOG_LEVEL);

#if 0
static UdpServer udp_server;
static uint8_t udp_rx_buf[1024];

static void
server_callback(void *server, int sock, uint8_t *data, uint16_t len, int *finished)
{
    UdpServer *svr = (UdpServer *)server;
    socklen_t addrlen = sizeof(svr->src_addr);

    (void)UdpSocket_writeto(sock, data, len, &svr->src_addr, addrlen);
    *finished = 1;
}
#endif

int
app_UdpServer_init(void)
{
