#include <zephyr/kernel.h>
#include <zephyr/logging/log.h>

#include "TcpServer.h"
#include "TcpSocket.h"
#include "app.h"

LOG_MODULE_DECLARE(app, CONFIG_APP_LOG_LEVEL);

#if 0
static TcpServer tcp_server;
static uint8_t tcp_rx_buf[1024];

/** @brief Called for each received chunk. Set *finished when the exchange is
    complete so the server can move on. */
static void
server_callback(void *server, int sock, uint8_t *data, uint16_t len, int *finished)
{
    ARG_UNUSED(server);

    (void)TcpSocket_write(sock, data, len);
    *finished = 1;
}
#endif

int
app_TcpServer_init(void)
{
#if 0   /* TODO: enable and adapt. */
    int ret;

    ret = TcpServer_init(
        &tcp_server,
        12001,                  /* port        */
        tcp_rx_buf,             /* buf         */
        sizeof(tcp_rx_buf),     /* buf_len     */
        4*1024,                 /* stack size  */
        "TCP Server",           /* thread name */
        20,                     /* priority    */
        server_callback);
    if (ret < 0)
    {
        LOG_ERR("Error initializing TcpServer: %d", ret);
        return ret;
    }
#endif
    return 0;
}
