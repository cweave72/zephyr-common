/*******************************************************************************
 *  @file: led.h
 *
 *  @brief: Onboard LED via the devicetree "led0" alias.
 *
 *  Every function here is a no-op when the board provides no led0 alias, so an
 *  app with the LED option enabled still builds and runs on a board without
 *  one. app_led_init() says so once at startup.
*******************************************************************************/
#ifndef APP_LED_H
#define APP_LED_H

#include <stdbool.h>

/******************************************************************************
    [docexport app_led_init]
*//**
    @brief Configures the led0 GPIO as an output.
    @return Returns 0 on success or when no led0 alias exists, negative on error.
******************************************************************************/
int
app_led_init(void);

/******************************************************************************
    [docexport app_led_set]
*//**
    @brief Drives the LED.
    @param[in] on  true to light the LED.
******************************************************************************/
void
app_led_set(bool on);

/******************************************************************************
    [docexport app_led_toggle]
*//**
    @brief Inverts the LED state.
******************************************************************************/
void
app_led_toggle(void);
#endif
