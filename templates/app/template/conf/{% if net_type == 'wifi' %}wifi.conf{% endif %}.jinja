CONFIG_WIFI=y
CONFIG_WIFICONNECT=y
CONFIG_NET_L2_WIFI_MGMT=y
CONFIG_NVPARMS=y

# WifiConnect and NvParms both use RtosUtils, whose header is only on the
# include path when CONFIG_RTOSUTILS=y.
CONFIG_RTOSUTILS=y

# Logging
CONFIG_NVPARMS_LOG_LEVEL_INF=y
CONFIG_WIFICONNECT_LOG_LEVEL_INF=y
CONFIG_NET_L2_WIFI_MGMT_LOG_LEVEL_INF=y
CONFIG_WIFI_LOG_LEVEL_INF=y
