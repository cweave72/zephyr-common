# File system for the FsApi module. boards/<board>.overlay supplies the
# partition and the fsapi_lfs fstab node. conf/modules.conf enables FSAPI and
# the Zephyr file system symbols it depends on.
CONFIG_FLASH=y
CONFIG_FLASH_MAP=y

# Must be >= cache-size in the fsapi_lfs fstab node. littlefs sizes its file
# cache heap from this value, so a smaller value fails the second open with
# -ENOMEM. FsApi checks this at build time.
CONFIG_FS_LITTLEFS_CACHE_SIZE=256
{%- if use_rpc %}

# Remote access to the file system (FsApiRpc callset, registered in src/rpc.c).
CONFIG_FSAPIRPC=y
CONFIG_FSAPIRPC_LOG_LEVEL_INF=y
{%- endif %}
