CONFIG_NET_CONNECTION_MANAGER=y
CONFIG_NET_CONFIG_SETTINGS=y
CONFIG_NET_CONFIG_AUTO_INIT=n
CONFIG_NET_MGMT_EVENT_QUEUE_SIZE=8

CONFIG_NET_IF_MAX_IPV4_COUNT=2

CONFIG_ENTROPY_GENERATOR=y
CONFIG_TEST_RANDOM_GENERATOR=y

# USB device stack, CDC-ECM ethernet class. app_net_init() calls usb_enable()
# itself, so the stack must not initialize at boot.
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_NETWORK_ECM=y
CONFIG_USB_DEVICE_INITIALIZE_AT_BOOT=n

# Logging
CONFIG_NET_CONFIG_LOG_LEVEL_DBG=y
CONFIG_USB_DRIVER_LOG_LEVEL_WRN=y
CONFIG_USB_DEVICE_LOG_LEVEL_WRN=y
CONFIG_USB_DEVICE_NETWORK_LOG_LEVEL_WRN=y
