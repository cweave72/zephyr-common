config FSAPI
	bool "Enable the FsApi lib"
	default n
	depends on FILE_SYSTEM
	depends on FILE_SYSTEM_LITTLEFS
	depends on FILE_SYSTEM_MKFS
	help
	  Handle-based file system API over the Zephyr VFS and littlefs.
	  FsApi_init mounts every enabled zephyr,fstab,littlefs node.
	  FsApi_addMount adds any other mount, for example littlefs on a RAM
	  disk. FILE_SYSTEM_MKFS provides fs_mkfs for FsApi_format.

if FSAPI

config FSAPI_MAX_MOUNTS
	int "Maximum number of mounts"
	default 2
	help
	  Size of the mount table: the fstab nodes plus the FsApi_addMount
	  mounts.

config FSAPI_MAX_OPEN_FILES
	int "Maximum number of open file handles"
	default 4
	help
	  Size of the file handle pool. CONFIG_FS_LITTLEFS_NUM_FILES must be
	  greater than or equal to this value.

config FSAPI_MAX_OPEN_DIRS
	int "Maximum number of open directory handles"
	default 2
	help
	  Size of the directory handle pool. CONFIG_FS_LITTLEFS_NUM_DIRS must
	  be greater than this value, because FsApi_listDir uses one more
	  directory.

endif # FSAPI

config FSAPIRPC
	bool "Enable the FsApiRpc callset"
	depends on FSAPI
	depends on NANOPB
	depends on PBGENERIC
	depends on PROTORPC
	help
	  ProtoRpc callset for remote access to the FsApi file system.

module = FSAPI
module-str = "FsApi"
source "subsys/logging/Kconfig.template.log_config"

module = FSAPIRPC
module-str = "FsApiRpc"
source "subsys/logging/Kconfig.template.log_config"
