CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=125000000
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_GPIO=y
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_BUILD_OUTPUT_HEX=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_RESET=y
CONFIG_CLOCK_CONTROL=y

# Console over USB CDC-ACM (see the chosen node in w55rp20_evb_pico.dts).
# USB_CDC_ACM enables itself from the devicetree node; only the stack and the
# line-control support needed for DTR handling have to be turned on here.
CONFIG_USB_DEVICE_STACK=y
CONFIG_UART_LINE_CTRL=y
